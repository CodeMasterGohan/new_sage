# New_sage environment — copy to .env and adjust.
# Create deploy/.env and set strong unique passwords before starting Compose.
# Restrict the MCP bind interface to loopback or a trusted Tailscale IP.

# ── secrets (CHANGE these) ───────────────────────────────────────
POSTGRES_USER=sage
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=sage
RUSTFS_ACCESS_KEY=sage
RUSTFS_SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

# ── Milvus collection ────────────────────────────────────────────
MILVUS_COLLECTION=sage_chunks
MILVUS_WAIT_TIMEOUT_S=600

# ── model artifacts (staged in the model-artifacts volume) ───────
MODEL_PATH=/artifacts/embeddinggemma-2
MINILM_MODEL_PATH=/artifacts/minilm
MINILM_TOKENIZER_PATH=/artifacts/minilm

# ── host port remapping (container ports are fixed per the port contract;
#    these change only the HOST side, e.g. when colocating with new_DRUID) ─
# Loopback prevents unauthenticated MCP access from the public network.
MCP_BIND_IP=127.0.0.1
MCP_HOST_PORT=8010

# Pin database versions; upgrade only after backup + compatibility checks.
MILVUS_IMAGE=milvusdb/milvus:v2.6.24

# Off by default: enqueue registered missing library versions automatically.
SAGE_AUTO_CRAWL=0
SAGE_RESOLVER_REFRESH_SECONDS=60
